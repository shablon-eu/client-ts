{
  "name": "@shablon-eu/client",
  "version": "1.1.4",
  "description": "",
  "repository": "https://github.com/shablon-eu/client-ts",
  "scripts": {
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "test": "vitest run",
    "ci": "pnpm run build && pnpm run check-format && pnpm run test",
    "prepublishOnly": "pnpm run ci",
    "create-release": "changeset",
    "local-release": "changeset version && changeset publish",
    "build": "tsc",
    "upgrade:major": "syncpack update --target latest",
    "upgrade:minor": "syncpack update --target minor",
    "upgrade:patch": "syncpack update --target patch"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "24.12.2",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "syncpack": "15.0.0"
  },
  "keywords": [],
  "author": "Michael Schramm <michael@ms07.at>",
  "license": "MIT",
  "packageManager": "pnpm@10.11.1",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "dependencies": {
    "node-fetch": "3.3.2"
  }
}
